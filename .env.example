# Copy this file to `.env` and fill in the real values.
# `.env` is gitignored - secrets never go in code or in git.

# --- Azure Document Intelligence (Layer 1) ---
# From Azure portal: your Document Intelligence resource
#   → "Keys and Endpoint" (left menu, under Resource Management)
AZURE_DOCINTEL_ENDPOINT=https://<your-resource-name>.cognitiveservices.azure.com/
AZURE_DOCINTEL_KEY=<paste KEY 1 here>

# Fields whose OCR confidence is below this are flagged for extra human attention.
# (Every field is human-reviewed regardless - this only controls the warning flag.)
CONFIDENCE_THRESHOLD=0.80

# --- Database ---
# Layer 1: local SQLite file. Layer 2 will swap this to an Azure PostgreSQL URL -
# same interface, different URL.
DATABASE_URL=sqlite:///./claims.db
